# ePeddlers Backend environment (copy to .env)
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# CORS: comma-separated allowed origins (web dev server, expo web)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=epeddlers
DB_USER=root
DB_PASS=

# Absolute path for private uploaded files (OUTSIDE the public web root)
STORAGE_PATH=C:/xampp/htdocs/LCCPBPA/epeddlers-backend/storage

# Token lifetime in seconds (0 = no expiry)
TOKEN_TTL=0
